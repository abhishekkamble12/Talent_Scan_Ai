# ==============================================================================
# AI Resume Screener - Reference Environment Configuration
# ==============================================================================
# Copy this file to '.env' and provide your Gemini API key:
#   copy .example_env .env
# ==============================================================================

# Google Gemini API Key (Required for RAG Embeddings & Candidate Q&A)
# Obtain a free API key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# Alternative alias recognized by the backend:
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Backend Server Configuration
FLASK_ENV=development
PORT=5000
HOST=0.0.0.0
